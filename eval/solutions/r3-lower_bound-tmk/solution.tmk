// Returns the smallest index i with a[i] >= key, or a.len if none.
// `a` must be sorted in non-decreasing order (per specification). The
// sortedness is not stated as a `requires` so that callers pay no run-time
// check for it; the postconditions below hold for any array and, for a
// sorted array, uniquely identify the lower bound.
pub fn lower_bound(a: [int], key: int) -> int
  ensures 0 <= result && result <= a.len
  ensures result < a.len ==> a[result] >= key
  ensures result > 0 ==> a[result - 1] < key
{
  var lo = 0
  var hi = a.len
  while lo < hi
    invariant 0 <= lo && lo <= hi && hi <= a.len
    invariant lo > 0 ==> a[lo - 1] < key
    invariant hi < a.len ==> a[hi] >= key
    decreases hi - lo
  {
    let mid = lo + (hi - lo) / 2
    if a[mid] < key { lo = mid + 1 } else { hi = mid }
  }
  lo
}
