// Exact sum of 64-bit integers with overflow detection.
// Invariant: the exact partial sum equals k * 2^62 + s, with -2^62 <= s < 2^62.
pub fn exact_sum(a: [int]) -> int? {
  let b = 4_611_686_018_427_387_904 // 2^62
  var s = 0
  var k = 0
  for i in 0..a.len
    invariant -b <= s && s < b
    invariant -3 * i <= k && k <= 3 * i
  {
    let x = a[i]
    let q = x / b        // in [-2, 1]
    let r = x % b        // |r| < 2^62, x == q * b + r
    k += q
    s += r
    if s >= b {
      s -= b
      k += 1
    } else if s < -b {
      s += b
      k -= 1
    }
  }
  // total = k * b + s; int.max = 2b - 1, int.min = -2b
  if k >= 3 || k <= -3 { return None }
  if k == 2 {
    if s < 0 { return Some((b + s) + b) }
    return None
  }
  if k == -2 {
    if s >= 0 { return Some((s - b) - b) }
    return None
  }
  Some(k * b + s)
}
