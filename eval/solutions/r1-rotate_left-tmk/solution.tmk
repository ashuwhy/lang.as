pub fn rotate_left(a: [int], k: int) -> [int]
  requires k >= 0
  ensures result.len == a.len
  ensures a.len > 0 ==> forall i in 0..a.len: result[i] == a[(i + k % a.len) % a.len]
{
  let n = a.len
  if n == 0 { return [0; 0] }
  let s = k % n
  var r = [0; n]
  var i = 0
  while i < n
    invariant 0 <= i && i <= n
    invariant r.len == n
    invariant forall j in 0..i: r[j] == a[(j + s) % n]
    decreases n - i
  {
    var src = i + s
    if src >= n { src = src - n }
    r[i] = a[src]
    i += 1
  }
  r
}
