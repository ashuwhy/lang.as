// The running total of a[0..i] is s + k * 2^63, with s always a valid int.
// Each step that would leave the int range moves s by 2^63 and counts it in k.
pub fn exact_sum(a: [int]) -> int?
{
  var s = 0
  var k = 0
  var i = 0
  while i < a.len
    invariant 0 <= i && i <= a.len
    invariant -i <= k && k <= i
    decreases a.len - i
  {
    let x = a[i]
    if x >= 0 && s > int.max - x {
      s = (s - int.max - 1) + x
      k += 1
    } else if x < 0 && s < int.min - x {
      s = (s + int.max + 1) + x
      k -= 1
    } else {
      s = s + x
    }
    i += 1
  }
  // |k| >= 2 puts the total at least 2^63 past a bound, whatever s is.
  if k == 0 {
    Some(s)
  } else if k == 1 && s < 0 {
    Some(s + int.max + 1)
  } else if k == -1 && s >= 0 {
    Some(s - int.max - 1)
  } else {
    None
  }
}
