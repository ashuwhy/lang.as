// Integer square root over the full non-negative 64-bit range.
// Largest r with r*r <= n; for n = int.max this is 3_037_000_499.
// Binary search keeps lo*lo <= n < hi*hi; hi starts at 3_037_000_500, whose
// square exceeds int.max, so every probed mid (< hi) squares without overflow.
pub fn isqrt(n: int) -> int
  requires 0 <= n
  ensures 0 <= result
  ensures result * result <= n && n < (result + 1) * (result + 1)
{
  var lo = 0
  var hi = 3_037_000_500
  while hi - lo > 1
    invariant 0 <= lo && lo < hi && hi <= 3_037_000_500
    invariant lo * lo <= n && n < hi * hi
    decreases hi - lo
  {
    let mid = lo + (hi - lo) / 2
    if mid * mid <= n { lo = mid } else { hi = mid }
  }
  lo
}
