pub fn max_window_sum(a: [int], k: int) -> int
  requires 1 <= a.len && a.len <= 1_000_000
  requires forall i in 0..a.len: -1_000_000_000_000 <= a[i] && a[i] <= 1_000_000_000_000
  requires 1 <= k && k <= a.len
{
  let n = a.len
  // p[j] = a[0] + ... + a[j-1]; |p[j]| <= j * 10^12
  var p = [0; n + 1]
  for i in 0..n
    invariant forall j in 0..i + 1: -j * 1_000_000_000_000 <= p[j] && p[j] <= j * 1_000_000_000_000
  {
    p[i + 1] = p[i] + a[i]
  }
  var best = p[k] - p[0]
  for i in 1..n - k + 1 {
    let s = p[i + k] - p[i]
    if s > best { best = s }
  }
  best
}
